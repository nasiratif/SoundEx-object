			{
				"Title": "Set master volume to %0",
				"Parameters": [
					[ "Float", "Volume (ranges from 0.0-1.0, higher values will create distortion)" ]
				]
			},
			{
				"Title": "Set channel %0's volume to %1",
				"Parameters": [
					[ "Integer", "Channel number" ],
					[ "Float", "Volume (ranges from 0.0-1.0, higher values will create distortion)" ]
				]
			},
			{
				"Title": "Set channel %0's frequency to %1",
				"Parameters": [
					[ "Integer", "Channel number" ],
					[ "Float", "Frequency (starts at 1.0, higher values create higher pitch, lower values create lower pitches)" ]
				]
			},
			{
				"Title": "Set channel %0's pan to %1",
				"Parameters": [
					[ "Integer", "Channel number" ],
					[ "Float", "Pan (ranges from -1.0 to 1.0, -1.0 being far left, 0.0 being center, 1.0 being far right)" ]
				]
			},
			{
				"Title": "Set channel %0's position to %1",
				"Parameters": [
					[ "Integer", "Channel number" ],
					[ "Integer", "Sample position" ]
				]
			},
			{
				"Title": "Set XAPO FXReverb effect on channel %0",
				"Parameters": [
					[ "Integer", "Channel number" ]
				]
			},
			{
				"Title": "Set Princeton reverb effect on channel %0",
				"Parameters": [
					[ "Integer", "Channel number" ]
				]
			},
			{
				"Title": "Set XAPO FXReverb diffusion on channel %0 to %1",
				"Parameters": [
					[ "Integer", "Channel number" ],
					[ "Float", "Diffusion (ranges from 0.0-1.0, default: 0.5)" ]
				]
			},
			{
				"Title": "Set XAPO FXReverb room size on channel %0 to %1",
				"Parameters": [
					[ "Integer", "Channel number" ],
					[ "Float", "Room size (ranges from 0.0001-1.0, default: 0.5)" ]
				]
			},
			{
