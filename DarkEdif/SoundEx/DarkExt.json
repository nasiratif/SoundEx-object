				]
			},
			{
				"Title": "Unload all sound files"
			},
			{
				"Title": "Play sound (ex) %0 on channel %1, loop %2, volume %3, frequency %4, pan %5 after %6 ms",
				"Parameters": [
					[ "Text", "Enter the name of the sound you loaded via \"Load sound file\" (case sensitive)" ],
