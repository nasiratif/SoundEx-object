		"Actions": [
			{
				"Title": "Load sound file %0 under name %1",
				"Parameters": [
					[ "Filename", "Enter the filename of this sound" ],
					[ "Text", "Enter a name for this sound (maximum length is 64 characters, this is the name you'll use to play it)" ]
				]
			},
			{
				"Title": "Play sound %0 on channel %1, loop %2",
				"Parameters": [
					[ "Text", "Enter the name of the sound you loaded via \"Load sound file\" (case sensitive)" ],
					[ "Integer", "Channel number (ranges from 0-63, -1 for automatic channel)" ],
					[ "Integer", "Loop this sound? (0 = no, 1 = yes)" ]
				]
			},
			{
				"Title": "Stop channel %0",
				"Parameters": [
					[ "Integer", "Channel number" ]
				]
